  "components": [
    {"type": "library", "name": "spring-boot-starter-web", "version": "3.2.5", "group": "org.springframework.boot"},
    {"type": "library", "name": "spring-boot-starter-data-jpa", "version": "3.2.5", "group": "org.springframework.boot"},
    {"type": "library", "name": "spring-boot-starter-security", "version": "3.2.5", "group": "org.springframework.boot"},
    {"type": "library", "name": "spring-boot-starter-validation", "version": "3.2.5", "group": "org.springframework.boot"},
